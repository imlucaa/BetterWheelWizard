<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:WheelWizard.Localization"
             xmlns:components="clr-namespace:WheelWizard.Views.Components"
             xmlns:miiViews="clr-namespace:WheelWizard.MiiImages.Views"
             mc:Ignorable="d"
             d:DesignWidth="477"
             d:DesignHeight="700"
             x:Class="WheelWizard.WheelWizardData.Views.LeaderboardPage"
             x:DataType="community:LeaderboardPage"
        xmlns:rooms="clr-namespace:WheelWizard.RrRooms.Views"
        xmlns:community="clr-namespace:WheelWizard.WheelWizardData.Views">
    <UserControl.Styles>
        <!-- Keep leaderboard search consistent with the translucent shell controls. -->
        <Style Selector="components|ActionButton.LeaderboardSearchTranslucent">
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource Neutral100}" />
        </Style>
        <Style Selector="components|ActionButton.LeaderboardSearchTranslucent:pointerover">
            <Setter Property="Background" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherReadableSurfaceBrush}" />
        </Style>
        <Style Selector="components|ActionButton.LeaderboardSearchTranslucent:pressed">
            <Setter Property="Background" Value="{DynamicResource LauncherPanelBrush}" />
        </Style>
        <!-- Match RoomDetailsPage entry background treatment for PlayerListItem -->
        <Style Selector="rooms|PlayerListItem /template/ Border.BoxItemBackground">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="{DynamicResource Neutral900}" />
        </Style>
        <Style Selector="rooms|PlayerListItem:pointerover /template/ Border.BoxItemBackground">
            <Setter Property="Background" Value="{DynamicResource Neutral700}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
            <TextBlock Grid.ColumnSpan="2" HorizontalAlignment="Center" Text="{loc:T page_title.leaderboard}" Classes="PageTitleText" IsVisible="{Binding !HasActiveSearchResult}" />
            <components:ActionButton Grid.Column="1"
                                     Classes="LeaderboardSearchTranslucent"
                                     Text="{loc:T action.search}"
                                     IconData="{StaticResource Search}"
                                     IsEnabled="{Binding CanSearchLeaderboard}"
                                     Click="SearchLeaderboardPlayer_OnClick"
                                     Margin="0,0,4,8" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20"
                        Spacing="10">
                <components:Spinner Width="68"
                                        Height="68"
                                        HorizontalAlignment="Center" />
                <TextBlock Text="{loc:T state.loading_leaderboard}"
                           Classes="BodyText"
                           FontSize="14"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasError}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20"
                        Spacing="10">
                <PathIcon Data="{StaticResource WarningTriangle}"
                          Width="56"
                          Height="56"
                          Foreground="{StaticResource Danger500}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="{loc:T message_error.failed_load_leaderboard}"
                           Classes="TitleText"
                           FontSize="18"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                            Classes="BodyText"
                            MaxWidth="310"
                            TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <components:ActionButton Text="{loc:T action.retry}"
                                   Tone="Brand"
                                   IconData="{StaticResource Refresh}"
                                   Width="160"
                                   HorizontalAlignment="Center"
                                   Click="RetryButton_OnClick" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasNoData}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <components:EmptyPageInfo Title="{loc:T empty_content.no_leaderboard_title}"
                                          BodyText="{loc:T empty_content.no_leaderboard}"
                                          IconData="{StaticResource Award}" />
                <components:ActionButton Text="{loc:T action.refresh}"
                                   Tone="Brand"
                                   IconData="{StaticResource Refresh}"
                                   Width="170"
                                   HorizontalAlignment="Center"
                                   Click="RetryButton_OnClick" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding HasData}"
                          Margin="12,8,12,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          IsScrollInertiaEnabled="True">
                <StackPanel Spacing="10"
                             Margin="0,0,0,12">
                    <Border IsVisible="{Binding HasLeaderboardSearchStatus}"
                            Background="{DynamicResource LauncherPanelBrush}"
                            BorderBrush="{DynamicResource LauncherPanelBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <TextBlock Text="{Binding LeaderboardSearchStatus}"
                                   Classes="BodyText" TextWrapping="Wrap" />
                    </Border>

                    <Border IsVisible="{Binding HasActiveSearchResult}"
                            Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="4,8">
                        <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="8">
                            <Border Width="96" Height="140" ClipToBounds="True" Background="Transparent" VerticalAlignment="Center">
                                <!-- Laid out larger than the frame and clipped: the Mii scales with the stage height, so this zooms in. -->
                                <Grid x:Name="SearchResultStageHost" Margin="-18,-18" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SearchResultPlayerName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SearchResultFriendCode}" Classes="TinyText" />
                                <WrapPanel>
                                    <TextBlock Text="{Binding SearchResultRankText}" FontWeight="Bold" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Neutral100}" />
                                    <TextBlock Text="{Binding SearchResultVrText}" Classes="BodyText" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" Width="112">
                                <components:ActionButton Classes="LeaderboardSearchTranslucent"
                                                         Text="{loc:T action.view_profile}"
                                                         Size="Compact" HorizontalAlignment="Stretch"
                                                         Click="OpenSearchProfile_OnClick" />
                                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasMultipleSearchResults}">
                                    <components:ActionButton Classes="LeaderboardSearchTranslucent"
                                                             IconData="{StaticResource ArrowLeft}"
                                                             Size="Compact" IsCircular="True"
                                                             ToolTip.Tip="Previous matching player"
                                                             Click="PreviousSearchMatch_OnClick" />
                                    <TextBlock Grid.Column="1" Text="{Binding SearchResultMatchIndex}" Classes="TinyText"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <components:ActionButton Grid.Column="2"
                                                             Classes="LeaderboardSearchTranslucent"
                                                             IconData="{StaticResource ArrowRight}"
                                                             Size="Compact" IsCircular="True"
                                                             ToolTip.Tip="Next matching player"
                                                             Click="NextSearchMatch_OnClick" />
                                </Grid>
                                <components:ActionButton Classes="LeaderboardSearchTranslucent"
                                                         Text="Close" Size="Compact" HorizontalAlignment="Stretch"
                                                         Click="CloseSearchResult_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border>
                        <Grid RowDefinitions="Auto,Auto"
                              ClipToBounds="False">

                            <!-- The top three stand on a podium in 3D. Pulled up a bit so confetti can fly over the header. -->
                            <community:LeaderboardPodiumStage x:Name="PodiumStage"
                                                              Grid.Row="1"
                                                              Height="380"
                                                              Margin="0,-24,0,0"
                                                              First="{Binding PodiumFirst.Mii}"
                                                              Second="{Binding PodiumSecond.Mii}"
                                                              Third="{Binding PodiumThird.Mii}">
                                <community:LeaderboardPodiumStep community:LeaderboardPodiumStage.Place="2"
                                                                 Classes="Silver"
                                                                 IsVisible="{Binding HasPodiumSecond}"
                                                                 Rank="{Binding PodiumSecond.Rank}"
                                                                 PlayerName="{Binding PodiumSecond.Name}"
                                                                 VrText="{Binding PodiumSecond.VrText}"
                                                                 ShowBadge="{Binding PodiumSecond.HasBadge}"
                                                                 BadgeVariant="{Binding PodiumSecond.PrimaryBadge}"
                                                                 IsSuspicious="{Binding PodiumSecond.IsSuspicious}">
                                    <community:LeaderboardPodiumStep.ContextMenu>
                                        <ContextMenu DataContext="{Binding PodiumSecond}">
                                            <MenuItem Header="{loc:T action.copy_friend_code}"
                                                      Click="CopyFriendCode_OnClick" />
                                            <MenuItem Header="{loc:T action.add_friend}"
                                                      Click="AddFriend_OnClick" />
                                            <Separator />
                                            <MenuItem Header="{loc:T action.view_profile}"
                                                      Click="ViewProfile_OnClick" />
                                            <MenuItem Header="View player on RWFC"
                                                      Click="ViewOnRwfc_OnClick" />
                                        </ContextMenu>
                                    </community:LeaderboardPodiumStep.ContextMenu>
                                </community:LeaderboardPodiumStep>
                                <community:LeaderboardPodiumStep community:LeaderboardPodiumStage.Place="1"
                                                                 Classes="Gold"
                                                                 IsVisible="{Binding HasPodiumFirst}"
                                                                 Rank="{Binding PodiumFirst.Rank}"
                                                                 PlayerName="{Binding PodiumFirst.Name}"
                                                                 VrText="{Binding PodiumFirst.VrText}"
                                                                 ShowBadge="{Binding PodiumFirst.HasBadge}"
                                                                 BadgeVariant="{Binding PodiumFirst.PrimaryBadge}"
                                                                 IsSuspicious="{Binding PodiumFirst.IsSuspicious}">
                                    <community:LeaderboardPodiumStep.ContextMenu>
                                        <ContextMenu DataContext="{Binding PodiumFirst}">
                                            <MenuItem Header="{loc:T action.copy_friend_code}"
                                                      Click="CopyFriendCode_OnClick" />
                                            <MenuItem Header="{loc:T action.add_friend}"
                                                      Click="AddFriend_OnClick" />
                                            <Separator />
                                            <MenuItem Header="{loc:T action.view_profile}"
                                                      Click="ViewProfile_OnClick" />
                                            <MenuItem Header="View player on RWFC"
                                                      Click="ViewOnRwfc_OnClick" />
                                        </ContextMenu>
                                    </community:LeaderboardPodiumStep.ContextMenu>
                                </community:LeaderboardPodiumStep>
                                <community:LeaderboardPodiumStep community:LeaderboardPodiumStage.Place="3"
                                                                 Classes="Bronze"
                                                                 IsVisible="{Binding HasPodiumThird}"
                                                                 Rank="{Binding PodiumThird.Rank}"
                                                                 PlayerName="{Binding PodiumThird.Name}"
                                                                 VrText="{Binding PodiumThird.VrText}"
                                                                 ShowBadge="{Binding PodiumThird.HasBadge}"
                                                                 BadgeVariant="{Binding PodiumThird.PrimaryBadge}"
                                                                 IsSuspicious="{Binding PodiumThird.IsSuspicious}">
                                    <community:LeaderboardPodiumStep.ContextMenu>
                                        <ContextMenu DataContext="{Binding PodiumThird}">
                                            <MenuItem Header="{loc:T action.copy_friend_code}"
                                                      Click="CopyFriendCode_OnClick" />
                                            <MenuItem Header="{loc:T action.add_friend}"
                                                      Click="AddFriend_OnClick" />
                                            <Separator />
                                            <MenuItem Header="{loc:T action.view_profile}"
                                                      Click="ViewProfile_OnClick" />
                                            <MenuItem Header="View player on RWFC"
                                                      Click="ViewOnRwfc_OnClick" />
                                        </ContextMenu>
                                    </community:LeaderboardPodiumStep.ContextMenu>
                                </community:LeaderboardPodiumStep>
                            </community:LeaderboardPodiumStage>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding RemainingPlayers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="community:LeaderboardPlayerItem">
                                <rooms:PlayerListItem UserName="{Binding Name}"
                                                           FriendCode="{Binding FriendCode}"
                                                           Vr="{Binding VrDisplay}"
                                                           Mii="{Binding FirstMii}"
                                                           IsOnline="{Binding IsOnline}"
                                                           ShowJoinRoomButton="True"
                                                           JoinRoomAction="JoinRoom_OnClick"
                                                           IsOpenHost="{Binding IsOpenHost}"
                                                           HasBadges="{Binding HasBadges}" BadgeVariants="{Binding BadgeVariants}"
                                                           IsTopPlayer="True"
                                                           TopLabel="{Binding TopLabel}" TopLabelVariant="{Binding RankBadgeVariant}">
                                    <rooms:PlayerListItem.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:T action.copy_friend_code}"
                                                      Click="CopyFriendCode_OnClick" />
                                            <MenuItem Header="{loc:T action.add_friend}"
                                                      Click="AddFriend_OnClick" />
                                            <Separator />
                                            <MenuItem Header="{loc:T action.view_profile}"
                                                      Click="ViewProfile_OnClick" />
                                            <MenuItem Header="View player on RWFC"
                                                      Click="ViewOnRwfc_OnClick" />
                                        </ContextMenu>
                                    </rooms:PlayerListItem.ContextMenu>
                                </rooms:PlayerListItem>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Margin="0,4"
                          VerticalAlignment="Center">
                        <components:ActionButton Classes="LeaderboardSearchTranslucent"
                                                 IconData="{StaticResource ArrowLeft}"
                                                 Size="Compact" IsCircular="True"
                                                 IsEnabled="{Binding CanGoToPreviousPage}"
                                                 ToolTip.Tip="Previous leaderboard page"
                                                 Click="PreviousLeaderboardPage_OnClick" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LeaderboardPageText}"
                                   Classes="TinyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <components:ActionButton Grid.Column="2"
                                                 Classes="LeaderboardSearchTranslucent"
                                                 IconData="{StaticResource ArrowRight}"
                                                 Size="Compact" IsCircular="True"
                                                 IsEnabled="{Binding CanGoToNextPage}"
                                                 ToolTip.Tip="Next leaderboard page"
                                                 Click="NextLeaderboardPage_OnClick" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
