<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:loc="clr-namespace:WheelWizard.Localization"
              xmlns:components="clr-namespace:WheelWizard.Views.Components"
              xmlns:patterns="clr-namespace:WheelWizard.Views.Patterns"
              xmlns:behaviorComponent="clr-namespace:WheelWizard.Views.Patterns"
              xmlns:miiVars="using:WheelWizard.MiiImages.Domain"
              xmlns:pages="clr-namespace:WheelWizard.Views.Pages"
             mc:Ignorable="d"
             d:DesignWidth="477"
             d:DesignHeight="700"
             x:Class="WheelWizard.Views.Pages.LeaderboardPage"
             x:DataType="pages:LeaderboardPage">
    <UserControl.Styles>
        <Style Selector="Border.LeaderboardSectionCard">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Neutral950}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Neutral900}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 10 26 0 #18000000" />
        </Style>
        <Style Selector="TextBlock.LeaderboardSectionTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Neutral100}" />
        </Style>
        <Style Selector="TextBlock.LeaderboardSectionCaption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Neutral300}" />
        </Style>
        <Style Selector="components|Button.SearchResultActionButton">
            <Setter Property="Background" Value="{DynamicResource Neutral800}" />
            <Setter Property="Foreground" Value="{StaticResource Neutral100}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Neutral700}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="components|Button.SearchResultNavButton">
            <Setter Property="Background" Value="{DynamicResource Neutral800}" />
            <Setter Property="Foreground" Value="{StaticResource Neutral100}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Neutral700}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.LeaderboardSearchHero">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource Neutral950}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Neutral900}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.PodiumStep">
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="BoxShadow" Value="0 8 18 0 #18000000" />
        </Style>
        <Style Selector="Border.PodiumStep.GoldStep">
            <Setter Property="BorderBrush" Value="#90D8A443" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A86D5423" Offset="0" />
                    <GradientStop Color="#1E1A1A1A" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.PodiumStep.SilverStep">
            <Setter Property="BorderBrush" Value="#7E8EA5D8" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#805C6E8B" Offset="0" />
                    <GradientStop Color="#1E1A1A1A" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.PodiumStep.BronzeStep">
            <Setter Property="BorderBrush" Value="#988D6A4A" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#97594839" Offset="0" />
                    <GradientStop Color="#1E1A1A1A" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Match RoomDetailsPage entry background treatment for PlayerListItem -->
        <Style Selector="patterns|PlayerListItem /template/ Border.BoxItemBackground">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="{DynamicResource Neutral900}" />
        </Style>
        <Style Selector="patterns|PlayerListItem:pointerover /template/ Border.BoxItemBackground">
            <Setter Property="Background" Value="{DynamicResource Neutral700}" />
        </Style>
        <Style Selector="patterns|PlayerListItem /template/ Border#PART_TopLabelBadge">
            <Setter Property="Background" Value="{DynamicResource Neutral800}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Neutral600}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="patterns|PlayerListItem /template/ TextBlock#PART_TopLabelText">
            <Setter Property="Foreground" Value="{StaticResource Neutral100}" />
        </Style>
        <Style Selector="patterns|PlayerListItem /template/ Border.BoxItemBackground">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource Neutral950}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Neutral900}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="patterns|PlayerListItem:pointerover /template/ Border.BoxItemBackground">
            <Setter Property="Background" Value="{DynamicResource Neutral900}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Classes="LeaderboardSearchHero">
            <Grid ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0"
                        Width="1"
                        Opacity="0" />
                <TextBlock Grid.Column="1"
                           Text="Leaderboard"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Classes="PageTitleText" />
                <components:Button Grid.Column="2"
                                   x:Name="LeaderboardSearchButton"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text=""
                                   Width="40"
                                   Height="34"
                                   Padding="0"
                                   ButtonSize="Compact"
                                   IconData="{StaticResource Search}"
                                   Click="SearchLeaderboardPlayer_OnClick"
                                   ToolTip.Tip="Search leaderboard by friend code or player name" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20"
                        Spacing="10">
                <components:LoadingIcon Width="68"
                                        Height="68"
                                        Foreground="{DynamicResource Neutral700}"
                                        HorizontalAlignment="Center" />
                <TextBlock Text="Loading leaderboard..."
                           Classes="BodyText"
                           FontSize="14"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasError}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20"
                        Spacing="10">
                <PathIcon Data="{StaticResource WarningTriangle}"
                          Width="56"
                          Height="56"
                          Foreground="{StaticResource Danger500}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Could not load leaderboard."
                           Classes="TitleText"
                           FontSize="18"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                            Classes="BodyText"
                            MaxWidth="310"
                            TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <components:Button Text="Retry"
                                   Variant="Primary"
                                   IconData="{StaticResource Refresh}"
                                   Width="160"
                                   HorizontalAlignment="Center"
                                   Click="RetryButton_OnClick" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasNoData}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <components:EmptyPageInfo Title="No leaderboard data"
                                          BodyText="There are no ranked players available right now."
                                          IconData="{StaticResource Award}" />
                <components:Button Text="Refresh"
                                   Variant="Primary"
                                   IconData="{StaticResource Refresh}"
                                   Width="170"
                                   HorizontalAlignment="Center"
                                   Click="RetryButton_OnClick" />
            </StackPanel>

            <ScrollViewer IsVisible="{Binding HasData}"
                          Margin="10,10,10,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsScrollInertiaEnabled="True">
                <StackPanel Spacing="14"
                            Margin="0,0,0,12">
                    <Border x:Name="LeaderboardSearchResultCard"
                            IsVisible="False"
                            Classes="LeaderboardSectionCard"
                            Padding="10,8">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="60,*,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="6">
                            <Border Width="60" Height="60" CornerRadius="8" ClipToBounds="True"
                                     Background="{DynamicResource Neutral950}">
                                <patterns:MiiImageLoader x:Name="LeaderboardSearchPreview"
                                                         LoadingColor="{DynamicResource Neutral600}"
                                                         FallBackColor="{DynamicResource Neutral600}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="LeaderboardSearchName" FontSize="15" FontWeight="SemiBold"
                                           Text="Search for a player"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="LeaderboardSearchFriendCode" Classes="TinyText" />
                                <TextBlock x:Name="LeaderboardSearchStatus" Classes="TinyText"
                                            Foreground="{DynamicResource Neutral400}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="{DynamicResource Neutral800}" CornerRadius="10" Padding="8,4">
                                    <TextBlock x:Name="LeaderboardSearchRank" Text="#--" FontWeight="Bold"
                                                  HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="LeaderboardSearchVr" Text="--" FontWeight="SemiBold"
                                              HorizontalAlignment="Center" />
                            </StackPanel>

                            <components:Button Grid.Column="3"
                                               Text=""
                                               Width="28"
                                               Height="28"
                                               Padding="0"
                                               ButtonSize="Compact"
                                               VerticalAlignment="Top"
                                               IconData="{StaticResource Close}"
                                               Click="CloseSearchResult_OnClick"
                                               ToolTip.Tip="Close search result" />

                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                  ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="6">
                                <components:Button Text="" Width="28" MinWidth="28" Height="28" Padding="0"
                                                    IconData="{StaticResource ArrowLeft}"
                                                    ButtonSize="Compact"
                                                    Click="PreviousSearchMatch_OnClick" IsEnabled="False"
                                                    ToolTip.Tip="Previous matching player" />
                                <TextBlock Grid.Column="1" Classes="TinyText"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <components:Button Grid.Column="2" Text="" Width="28" MinWidth="28" Height="28" Padding="0"
                                                    IconData="{StaticResource ArrowRight}"
                                                    ButtonSize="Compact"
                                                    Click="NextSearchMatch_OnClick" IsEnabled="False"
                                                    ToolTip.Tip="Next matching player" />
                                <components:Button Grid.Column="3"
                                                    Text="Profile"
                                                    HorizontalAlignment="Left"
                                                    ButtonSize="Compact"
                                                    Click="OpenSearchProfile_OnClick"
                                                    IsEnabled="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Classes="LeaderboardSectionCard"
                            Padding="12,10">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ClipToBounds="False">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PodiumTitleText}"
                                            Classes="LeaderboardSectionTitle" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,2,0,0"
                                  ColumnDefinitions="*">
                                <Grid x:Name="SearchResultPodiumControls"
                                       IsVisible="False"
                                       ColumnDefinitions="Auto,Auto"
                                       ColumnSpacing="8"
                                       HorizontalAlignment="Center">
                                    <components:Button Grid.Column="0"
                                                        x:Name="LeaderboardSearchOpenProfileButton"
                                                        IsVisible="False"
                                                       Classes="SearchResultActionButton"
                                                       Text="View profile"
                                                       MinWidth="84"
                                                       ButtonSize="Compact"
                                                        Variant="Default"
                                                        Click="OpenSearchProfile_OnClick"
                                                        IsEnabled="False" />
                                    <components:Button Grid.Column="1"
                                                        x:Name="CloseSearchResultButton"
                                                        IsVisible="False"
                                                        Text="Back"
                                                        MinWidth="58"
                                                        ButtonSize="Compact"
                                                       Variant="Default"
                                                       Click="CloseSearchResult_OnClick"
                                                       ToolTip.Tip="Back to leaderboard" />
                                </Grid>
                                <TextBlock
                                            Text="{Binding PodiumCaptionText}"
                                            Classes="LeaderboardSectionCaption"
                                            Margin="0,34,0,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,8,0,0"
                                  MinHeight="176"
                                  IsVisible="True">
                                <Grid x:Name="SearchResultSingleLayout"
                                       IsVisible="False"
                                       ColumnDefinitions="Auto,Auto,Auto"
                                       ColumnSpacing="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                    <components:Button x:Name="PreviousSearchMatchButton"
                                                       Grid.Column="0"
                                                       Classes="SearchResultNavButton"
                                                       Text=""
                                                       Width="28"
                                                       MinWidth="28"
                                                       Height="28"
                                                       Padding="0"
                                                       ButtonSize="Compact"
                                                       VerticalAlignment="Center"
                                                       IconData="{StaticResource ArrowLeft}"
                                                       Click="PreviousSearchMatch_OnClick"
                                                       IsEnabled="False"
                                                       ToolTip.Tip="Previous matching player" />

                                     <Border x:Name="SearchResultCompactCard"
                                             Grid.Column="1"
                                             IsVisible="False"
                                             Width="184"
                                             MinHeight="168"
                                             Padding="12,12,12,11"
                                             CornerRadius="18"
                                             Background="#18343A42"
                                             BorderBrush="#E0D54A"
                                             BorderThickness="1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:T action.copy_friend_code}"
                                                          Click="CopyFriendCode_OnClick" />
                                                <MenuItem Header="{loc:T action.view_mii}"
                                                          Click="OpenCarousel_OnClick" />
                                                <MenuItem Header="Copy Mii to My Miis"
                                                          Click="CopyMii_OnClick" />
                                                <MenuItem Header="Add Friend"
                                                          Click="AddFriend_OnClick" />
                                                <Separator />
                                                <MenuItem Header="View Profile"
                                                          Click="OpenSearchProfile_OnClick" />
                                                <MenuItem Header="View Player on RWFC"
                                                          Click="ViewPlayerOnRwfc_OnClick" />
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                         <StackPanel Spacing="8"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                            <TextBlock x:Name="SearchResultRankText"
                                                       HorizontalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="White" />

                                             <Border Width="88"
                                                     Height="88"
                                                     CornerRadius="9999"
                                                     BorderBrush="#64FFFFFF"
                                                     BorderThickness="2"
                                                    Background="#22000000"
                                                    ClipToBounds="True"
                                                    HorizontalAlignment="Center">
                                                <Grid>
                                                    <PathIcon Data="{StaticResource User}"
                                                              Width="34"
                                                              Height="34"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="#52FFFFFF"
                                                              IsHitTestVisible="False" />
                                                    <behaviorComponent:MiiImageLoader x:Name="SearchResultMiiImage"
                                                                                      HorizontalAlignment="Stretch"
                                                                                      VerticalAlignment="Stretch"
                                                                                      LoadingColor="{DynamicResource Neutral600}"
                                                                                      FallBackColor="{DynamicResource Neutral600}"
                                                                                      ImageVariant="{x:Static miiVars:MiiImageVariants.MiiBlockProfile}" />
                                                </Grid>
                                            </Border>

                                             <TextBlock x:Name="SearchResultPlayerName"
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"
                                                        Width="148"
                                                        MinHeight="40"
                                                        TextWrapping="Wrap"
                                                        MaxLines="2"
                                                        FontWeight="Bold"
                                                        FontSize="15"
                                                       Foreground="White" />

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        HorizontalAlignment="Center">
                                                <PathIcon Data="{StaticResource Chart}"
                                                          Width="13"
                                                          Height="13"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource Neutral200}" />
                                                <TextBlock x:Name="SearchResultVrText"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Neutral100}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <components:Button x:Name="NextSearchMatchButton"
                                                       Grid.Column="2"
                                                       Classes="SearchResultNavButton"
                                                       Text=""
                                                       Width="28"
                                                       MinWidth="28"
                                                       Height="28"
                                                       Padding="0"
                                                       ButtonSize="Compact"
                                                       VerticalAlignment="Center"
                                                       IconData="{StaticResource ArrowRight}"
                                                       Click="NextSearchMatch_OnClick"
                                                       IsEnabled="False"
                                                       ToolTip.Tip="Next matching player" />

                                    <TextBlock x:Name="LeaderboardSearchMatchIndex"
                                               IsVisible="False" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,10,0,0"
                                  RowDefinitions="Auto,16"
                                  VerticalAlignment="Center"
                                  ColumnDefinitions="*,1.1*,*">
                                <patterns:LeaderboardPodiumCard Grid.Column="0"
                                                                  Grid.Row="0"
                                                                  Margin="4,16,4,0"
                                                                  x:Name="DefaultPodiumSecondCard"
                                                                  IsVisible="{Binding HasPodiumSecond}"
                                                                  Classes="Silver EntrySecond FloatB"
                                                                  Rank="{Binding PodiumSecond.Rank}"
                                                                  PlacementLabel="{Binding PodiumSecond.PlacementLabel}"
                                                                  PlayerName="{Binding PodiumSecond.Name}"
                                                                  VrText="{Binding PodiumSecond.VrText}"
                                                                  Mii="{Binding PodiumSecond.Mii}"
                                                                  ShowBadge="{Binding PodiumSecond.HasBadge}"
                                                                  BadgeVariant="{Binding PodiumSecond.PrimaryBadge}"
                                                                  IsSuspicious="{Binding PodiumSecond.IsSuspicious}">
                                    <patterns:LeaderboardPodiumCard.ContextMenu>
                                        <ContextMenu DataContext="{Binding PodiumSecond}">
                                            <MenuItem Header="{loc:T action.copy_friend_code}"
                                                      Click="CopyFriendCode_OnClick" />
                                            <MenuItem Header="{loc:T action.view_mii}"
                                                      Click="OpenCarousel_OnClick" />
                                            <MenuItem Header="Copy Mii to My Miis"
                                                      Click="CopyMii_OnClick" />
                                            <MenuItem Header="Add Friend"
                                                      Click="AddFriend_OnClick" />
                                            <Separator />
                                            <MenuItem Header="View Profile"
                                                      Click="ViewProfile_OnClick" />
                                            <MenuItem Header="View Player on RWFC"
                                                      Click="ViewPlayerOnRwfc_OnClick" />
                                        </ContextMenu>
                                    </patterns:LeaderboardPodiumCard.ContextMenu>
                                </patterns:LeaderboardPodiumCard>

                                <patterns:LeaderboardPodiumCard Grid.Column="1"
                                                                  Grid.Row="0"
                                                                  Margin="4,0,4,0"
                                                                  x:Name="DefaultPodiumFirstCard"
                                                                  IsVisible="{Binding HasPodiumFirst}"
                                                                  Classes="Gold EntryFirst FloatA"
                                                                  AvatarSize="122"
                                                                  Rank="{Binding PodiumFirst.Rank}"
                                                                  PlacementLabel="{Binding PodiumFirst.PlacementLabel}"
                                                                  PlayerName="{Binding PodiumFirst.Name}"
                                                                  VrText="{Binding PodiumFirst.VrText}"
                                                                  Mii="{Binding PodiumFirst.Mii}"
                                                                  ShowBadge="{Binding PodiumFirst.HasBadge}"
                                                                  BadgeVariant="{Binding PodiumFirst.PrimaryBadge}"
                                                                  IsSuspicious="{Binding PodiumFirst.IsSuspicious}">
                                    <patterns:LeaderboardPodiumCard.ContextMenu>
                                        <ContextMenu DataContext="{Binding PodiumFirst}">
                                            <MenuItem Header="{loc:T action.copy_friend_code}"
                                                      Click="CopyFriendCode_OnClick" />
                                            <MenuItem Header="{loc:T action.view_mii}"
                                                      Click="OpenCarousel_OnClick" />
                                            <MenuItem Header="Copy Mii to My Miis"
                                                      Click="CopyMii_OnClick" />
                                            <MenuItem Header="Add Friend"
                                                      Click="AddFriend_OnClick" />
                                            <Separator />
                                            <MenuItem Header="View Profile"
                                                      Click="ViewProfile_OnClick" />
                                            <MenuItem Header="View Player on RWFC"
                                                      Click="ViewPlayerOnRwfc_OnClick" />
                                        </ContextMenu>
                                    </patterns:LeaderboardPodiumCard.ContextMenu>
                                </patterns:LeaderboardPodiumCard>

                                <patterns:LeaderboardPodiumCard Grid.Column="2"
                                                                  Grid.Row="0"
                                                                  Margin="4,16,4,0"
                                                                  x:Name="DefaultPodiumThirdCard"
                                                                  IsVisible="{Binding HasPodiumThird}"
                                                                  Classes="Bronze EntryThird FloatC"
                                                                  Rank="{Binding PodiumThird.Rank}"
                                                                  PlacementLabel="{Binding PodiumThird.PlacementLabel}"
                                                                  PlayerName="{Binding PodiumThird.Name}"
                                                                  VrText="{Binding PodiumThird.VrText}"
                                                                  Mii="{Binding PodiumThird.Mii}"
                                                                  ShowBadge="{Binding PodiumThird.HasBadge}"
                                                                  BadgeVariant="{Binding PodiumThird.PrimaryBadge}"
                                                                  IsSuspicious="{Binding PodiumThird.IsSuspicious}">
                                    <patterns:LeaderboardPodiumCard.ContextMenu>
                                        <ContextMenu DataContext="{Binding PodiumThird}">
                                            <MenuItem Header="{loc:T action.copy_friend_code}"
                                                      Click="CopyFriendCode_OnClick" />
                                            <MenuItem Header="{loc:T action.view_mii}"
                                                      Click="OpenCarousel_OnClick" />
                                            <MenuItem Header="Copy Mii to My Miis"
                                                      Click="CopyMii_OnClick" />
                                            <MenuItem Header="Add Friend"
                                                      Click="AddFriend_OnClick" />
                                            <Separator />
                                            <MenuItem Header="View Profile"
                                                      Click="ViewProfile_OnClick" />
                                            <MenuItem Header="View Player on RWFC"
                                                      Click="ViewPlayerOnRwfc_OnClick" />
                                        </ContextMenu>
                                    </patterns:LeaderboardPodiumCard.ContextMenu>
                                </patterns:LeaderboardPodiumCard>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Classes="LeaderboardSectionCard">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="8">
                                <StackPanel Spacing="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="Ranked players"
                                               Classes="LeaderboardSectionTitle" />
                                    <TextBlock Text="Current placements"
                                               Classes="LeaderboardSectionCaption" />
                                </StackPanel>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto,Auto,Auto,*"
                                      ColumnSpacing="6"
                                      VerticalAlignment="Center">
                                    <components:Button Text=""
                                                        Grid.Column="1"
                                                        Width="30"
                                                        Height="30"
                                                        Padding="0"
                                                        ButtonSize="Compact"
                                                        IconData="{StaticResource ArrowLeft}"
                                                       Click="PreviousLeaderboardPage_OnClick"
                                                       IsEnabled="{Binding CanGoToPreviousPage}"
                                                       ToolTip.Tip="Previous leaderboard page" />
                                    <Border Background="{DynamicResource Neutral900}"
                                            Grid.Column="2"
                                            CornerRadius="999"
                                            Padding="10,5"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LeaderboardPageText}"
                                                   Classes="TinyText"
                                                   Foreground="{StaticResource Neutral100}" />
                                    </Border>
                                    <components:Button Text=""
                                                        Grid.Column="3"
                                                        Width="30"
                                                        Height="30"
                                                        Padding="0"
                                                        ButtonSize="Compact"
                                                        IconData="{StaticResource ArrowRight}"
                                                       Click="NextLeaderboardPage_OnClick"
                                                       IsEnabled="{Binding CanGoToNextPage}"
                                                       ToolTip.Tip="Next leaderboard page" />
                                    <Border Background="{DynamicResource Neutral900}"
                                            Grid.Column="4"
                                            CornerRadius="999"
                                            Padding="10,5"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RemainingCountText}"
                                                   Classes="TinyText"
                                                   Foreground="{StaticResource Neutral100}" />
                                    </Border>
                                </Grid>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RemainingPlayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:LeaderboardPlayerItem">
                                        <patterns:PlayerListItem UserName="{Binding Name}"
                                                                   FriendCode="{Binding FriendCode}"
                                                                   Vr="{Binding VrDisplay}"
                                                                   Mii="{Binding FirstMii}"
                                                                   IsOnline="{Binding IsOnline}"
                                                                   ShowJoinRoomButton="True"
                                                                   JoinRoomAction="JoinRoom_OnClick"
                                                                   IsOpenHost="{Binding IsOpenHost}"
                                                                   HasBadges="{Binding HasBadges}"
                                                                   IsTopPlayer="True"
                                                                   TopLabel="{Binding TopLabel}">
                                            <patterns:PlayerListItem.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:T action.copy_friend_code}"
                                                              Click="CopyFriendCode_OnClick" />
                                                    <MenuItem Header="{loc:T action.view_mii}"
                                                              Click="OpenCarousel_OnClick" />
                                                    <MenuItem Header="Copy Mii to My Miis"
                                                              Click="CopyMii_OnClick" />
                                                    <MenuItem Header="Add Friend"
                                                              Click="AddFriend_OnClick" />
                                                    <Separator />
                                                    <MenuItem Header="View Profile"
                                                              Click="ViewProfile_OnClick" />
                                                    <MenuItem Header="View Player on RWFC"
                                                              Click="ViewPlayerOnRwfc_OnClick" />
                                                </ContextMenu>
                                            </patterns:PlayerListItem.ContextMenu>
                                        </patterns:PlayerListItem>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
