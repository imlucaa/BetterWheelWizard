<base:PopupContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:components="clr-namespace:WheelWizard.Views.Components"
                   xmlns:loc="clr-namespace:WheelWizard.Localization"
                   xmlns:base="clr-namespace:WheelWizard.Views.Popups.Base"
                   mc:Ignorable="d"
                   x:Class="WheelWizard.Views.Popups.Generic.MiiRenderingSetupPopup">
    <Grid Width="480" MinHeight="300" MaxHeight="420" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Classes="TitleText"
                    Text="{loc:T popup.mii_rendering_setup}" />

        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Classes="BodyText"
                    Text="{loc:T popup.mii_rendering_description}" />

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="14"
                Background="#12000000"
                BorderBrush="{DynamicResource Neutral700}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel Spacing="8">
                <TextBlock Classes="BodyText"
                           FontWeight="SemiBold"
                            Text="{loc:T attribute.install_location}" />
                <TextBlock x:Name="PathTextBlock"
                           Classes="BodyText"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    Spacing="8">
            <TextBlock x:Name="StatusTextBlock"
                       Classes="BodyText"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="DownloadProgressBar"
                         Minimum="0"
                         Maximum="100"
                         Height="10" />
            <TextBlock x:Name="ProgressTextBlock"
                       Classes="BodyText"
                       Opacity="0.75" />
            <TextBlock Classes="BodyText"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                        Text="{loc:T popup.mii_rendering_skip_help}" />
            <TextBlock x:Name="ErrorTextBlock"
                       Classes="BodyText"
                       Foreground="{StaticResource Danger400}"
                       TextWrapping="Wrap"
                       IsVisible="False" />
        </StackPanel>

        <UniformGrid Grid.Row="4"
                     Columns="2"
                     Margin="0,24,0,0">
            <components:Button x:Name="SkipButton"
                               Margin="0,0,6,0"
                               Variant="Default"
                                Text="{loc:T action.skip}"
                               Click="SkipButton_OnClick" />
            <components:Button x:Name="DownloadButton"
                               Margin="0,0,0,0"
                                Variant="Confirm"
                                Text="{loc:T action.download}"
                               Click="DownloadButton_OnClick" />
        </UniformGrid>
    </Grid>
</base:PopupContent>
