<base:PopupContent xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:base="clr-namespace:WheelWizard.Views.Popups.Base"
                   mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="520"
                   x:Class="WheelWizard.Views.Popups.Generic.ThemeLibraryWindow">
    <Grid Width="360" MaxHeight="560" RowDefinitions="Auto,*" Margin="0,4,0,0">
        <StackPanel Spacing="3" Margin="0,0,0,10">
            <TextBlock Text="Choose a theme" Classes="TitleText" FontSize="18"
                       Foreground="{StaticResource FormFieldLabelColor}" />
            <TextBlock Text="Select a built-in preset or one of your saved themes."
                       Classes="TinyText" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ThemeList" Spacing="6" />
        </ScrollViewer>
    </Grid>
</base:PopupContent>
